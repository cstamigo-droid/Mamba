step Fly to Auberdine
  zone Ashenvale
  zone Darkshore
  zone Ashenvale
  goto 34.5,48.0 "Astranaar flight master"

# ---------------------------------------------------------------- Menethil Harbor

step Caitlin Grassman
  zone Wetlands
  tip Off the boat, Caitlin Grassman stands beside Menethil's inn, on the way to the flight master.
  turnin 95737 only Dwarf,Gnome,Human,NightElf -- Caitlin Grassman, inside

step Fly to Ironforge
  zone Wetlands
  goto 9.5,59.7 "Menethil Harbor flight master"
  fly "Ironforge"
  zone Ironforge

# ---------------------------------------------------------------- Ironforge

step Fly to Ironforge
  zone Wetlands
  tip Shellei Brondir is the flight master by Menethil's inn.
  zone Ironforge
  zone Wetlands
  goto 9.5,59.7 "Menethil Harbor flight master"

step Ironforge
  zone Ironforge
  accept 1179 only Dwarf,Gnome,Human,NightElf -- Pilot Longbeard
  train class only Warrior,Paladin,Hunter,Rogue,Priest,Shaman,Mage,Warlock
  vendor nearest

step Ironforge priests
  only Dwarf,Gnome,Priest
  tip High Priest Rohan and High Priestess Mims are in the Hall of Mysteries, in the Mystic Ward.
  turnin 5645 only Dwarf                      -- High Priest Rohan: Chastise
  turnin 94819 only Gnome                     -- High Priestess Mims: Contingency Plan

step Tram to Stormwind
  zone Ironforge
  goto 78.0,51.4 "Tram to Stormwind"

step Baros Alexston
